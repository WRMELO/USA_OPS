    "task_id": "T-SDC-BAND-EXPANSION-ENTRY-VETO-US-V1",
    "hypothesis": "A expansao sistematica e monotonica da banda SPC (Carta-I), quando observada em candidatos elegiveis sem violacao SPC ativa em d_prev, identifica dessensibilizacao e piora risco-retorno futuro de entrada; o gate adiciona valor incremental ao Baseline C4 sem substituir R-001/R-037.",
    "arms": {
      "Baseline": "C4 puro sem gate adicional",
      "Arm_BandExp": "C4 + veto de candidato com Flag_BandExp em d_prev, com substituicao pelo proximo do ranking"
    },
    "indicator_definition": {
      "source_table": "canonical_us.parquet (freeze research_dataset_us_v2)",
      "formulas": {
        "width_t": "i_ucl_t - i_lcl_t",
        "band_exp20_t": "width_t / width_(t-20 pregoes) - 1",
        "w_diff_pos_t": "1 se width_t > width_(t-1), senao 0",
        "mono20_t": "media movel de w_diff_pos com janela=20 e min_periods=20, por ticker",
        "w_pct_dia_t": "rank percentual diario de width_t no cross-section",
        "w_ter_t": "tercil de w_pct_dia_t com cortes [0,1/3,2/3,1] e labels ESTREITA/MEDIA/LARGA",
        "exp_pct_dia_t": "rank percentual diario de band_exp20_t no cross-section",
        "viol_any_t": "violacao SPC ativa (i_value fora [i_lcl,i_ucl] OU xbar fora [xbar_lcl,xbar_ucl] OU mr_value>mr_ucl OU r_value>r_ucl), reaproveitando literalmente _build_spc_blocked_by_day",
        "Flag_BandExp_t": "(w_ter_t=='LARGA') AND (exp_pct_dia_t>=0.80) AND (mono20_t>=0.65) AND (viol_any_t==False)"
      }
    },
